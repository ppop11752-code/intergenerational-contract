PORT=3001
# Production: exact web origin(s), comma separated. Use * only for local/testing.
CORS_ORIGINS=*
MAX_ROOMS=100
ROOM_TTL_MS=7200000
ENDED_ROOM_TTL_MS=1800000
# Defaults match the locked turn flow.
MANDATORY_PRESENTATION_MS=7000
STATUS_TIMEOUT_MS=15000
VOLUNTARY_TIMEOUT_MS=60000
# Optional external static client build. Leave unset while the final UI is deferred.
# STATIC_DIR=/app/public
